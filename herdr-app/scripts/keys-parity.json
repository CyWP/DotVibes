{
  "_comment": "Keymap parity for the herdr-tui-layout on Linux. install.sh applies this to the person's keys.json; uninstall.sh reverts it. remove_defaults: Herdr's stock bindings for commands the layout's ctrl-b keys already provide — dropped so there is one way each. linux_twins: herdr-nvim's cmd- keys don't reach the app on Linux (no cmd mapping; cmd-shift-e is shadowed by the default ctrl-shift-e), so they get alt- twins, added only when mods/herdr-nvim is installed.",
  "remove_defaults": {
    "ctrl-shift-t": "tab.new",
    "ctrl-pagedown": "tab.next",
    "ctrl-tab": "tab.next",
    "alt-]": "tab.next",
    "ctrl-pageup": "tab.prev",
    "ctrl-shift-tab": "tab.prev",
    "alt-[": "tab.prev",
    "ctrl-shift-w": "tab.close",
    "f2": "tab.rename",
    "ctrl-shift-n": "space.new",
    "shift-f2": "space.rename",
    "alt-1": "space.select:1",
    "alt-2": "space.select:2",
    "alt-3": "space.select:3",
    "alt-4": "space.select:4",
    "alt-5": "space.select:5",
    "alt-6": "space.select:6",
    "alt-7": "space.select:7",
    "alt-8": "space.select:8",
    "alt-9": "space.select:9",
    "alt-h": "pane.go:left",
    "alt-j": "pane.go:down",
    "alt-k": "pane.go:up",
    "alt-l": "pane.go:right",
    "alt-left": "pane.go:left",
    "alt-right": "pane.go:right",
    "ctrl-shift-o": "pane.split:right",
    "ctrl-shift-e": "pane.split:down",
    "ctrl-shift-x": "pane.close",
    "ctrl-shift-z": "pane.zoom",
    "ctrl-shift-b": "layout.toggle:sidebar",
    "ctrl-,": "app.settings",
    "ctrl-?": "app.help",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help"
  },
  "linux_twins": {
    "alt-e": "herdr-nvim.reveal",
    "alt-o": "herdr-nvim.pick",
    "alt-shift-e": "mod.open:herdr-nvim"
  }
}

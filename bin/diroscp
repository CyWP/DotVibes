print_usage() {
    echo "Usage: $0 [-r] source target"
    echo "  -r       Recursively copy directories."
    echo "  source   Path to the local file or directory to copy."
    echo "  target   Remote file or directory path relative to /u/\$DIRO_USER/."
    exit 1
}

# Check for improper usage
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    print_usage
fi

# Check if the first argument is -r
if [ "$1" == "-r" ]; then
    if [ $# -ne 3 ]; then
        print_usage
    fi
    RECURSIVE="-r"
    SOURCE="$2"
    TARGET="$3"
else
    if [ $# -ne 2 ]; then
        print_usage
    fi
    RECURSIVE=""
    SOURCE="$1"
    TARGET="$2"
fi

# Execute the SCP command with or without -r
sshpass -p "$DIRO_PASS" scp $RECURSIVE "$SOURCE" "$DIRO_USER@arcade.iro.umontreal.ca:/u/$DIRO_USER/$TARGET"

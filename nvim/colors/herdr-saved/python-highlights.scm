;; extends

; assignment and equality signs in the lighter blue
; (all other operators keep the deep mint from colors/herdr.lua)
[
  "="
  "=="
  "!="
  ":="
  "+="
  "-="
  "*="
  "/="
  "//="
  "%="
  "**="
  "&="
  "|="
  "^="
  ">>="
  "<<="
  "@="
] @operator.assign

; the other arithmetic and bitwise symbols in blue too
[
  "+"
  "-"
  "*"
  "/"
  "//"
  "**"
  "%"
  "@"
  "&"
  "|"
  "^"
  "~"
  "<<"
  ">>"
  "->"
  "<>"
] @operator.math

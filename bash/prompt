# DotVibes shell — the two-line prompt (git branch + python environment).
#
# Arrow glyphs: lines end/start with '╭─' and '╰─»'. The second line's arrow is
# '»' (U+00BB) ON PURPOSE: the former '❯' (U+276F) is an East-Asian-ambiguous-
# width character, which some font/terminal combos (e.g. Ghostty + Monaspace
# Argon NF) render double-width while others render it narrow — shifting the
# second line sideways depending on where you run. '»' is narrow everywhere,
# so the alignment can't drift. If you continue using other ambiguous glyphs,
# keep in mind that font/term combos may render them differently.
#
# Sourced at the end of ~/.bashrc (after the interactive check), so it always
# wins over the skeleton's own prompt.

# Color detection: don't rely on TERM-name matching alone — ghostty uses
# TERM=xterm-ghostty (not *-256color), which took the non-color branch and
# rendered the uncolored prompt's indented second line ("extra space at the
# start of the line in ghostty only"). Ask the terminal what it can do
# instead: known names first, then a tput capability probe as fallback.
case "$TERM" in
    xterm-color|*-256color|xterm-ghostty*|xterm-kitty*|alacritty*|rxvt*)
        color_prompt=yes
        ;;
esac
if [ -z "${color_prompt:-}" ] && command -v tput > /dev/null 2>&1; then
    if tput setaf 1 > /dev/null 2>&1; then
        color_prompt=yes
    fi
fi

# Return the current Git branch and whether the working tree is clean.
__prompt_git() {
    local branch status

    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || return

    status=$(git status --porcelain --ignore-submodules 2>/dev/null)

    if [ -n "$status" ]; then
        printf '%s ✗' "$branch"
    else
        printf '%s ✓' "$branch"
    fi
}

# Return the active python environment + interpreter version, supporting
# venv, conda, micromamba and pyenv (first match wins — venvs typically nest
# inside conda envs, so VIRTUAL_ENV takes precedence).
# Subprocesses only run when needed: pyenv has no fast env var, so detecting
# it costs a call per prompt. A pyenv 'system' global is not shown (nothing
# to distinguish).
__prompt_python() {
    local env python_version

    if [ -n "${VIRTUAL_ENV:-}" ]; then
        env=$(basename "$VIRTUAL_ENV")
    elif [ -n "${CONDA_DEFAULT_ENV:-}" ]; then
        env=$CONDA_DEFAULT_ENV
    elif [ -n "${MAMBA_DEFAULT_ENV:-}" ]; then
        env=$MAMBA_DEFAULT_ENV
    elif [ -n "${PYENV_VERSION:-}" ]; then
        env=$PYENV_VERSION
    elif command -v pyenv > /dev/null 2>&1; then
        env=$(pyenv version-name 2> /dev/null) || env=
        [ "$env" = "system" ] && env=
    fi

    [ -n "$env" ] || return

    if command -v python > /dev/null 2>&1; then
        python_version=$(python --version 2> /dev/null | sed 's/^Python //')
    fi

    if [ -n "$python_version" ]; then
        printf '%s:%s' "$env" "$python_version"
    else
        printf '%s' "$env"
    fi
}

# Build the prompt before each command.
__prompt_update() {
    local git_info python_info

    git_info=$(__prompt_git)
    python_info=$(__prompt_python)

    if [ "${color_prompt:-}" = yes ]; then

        PS1='\[\033[01;36m\]╭─\[\033[00m\] '
        PS1+='\[\033[01;32m\]\u@\h\[\033[00m\]: '
        PS1+='\[\033[01;34m\]\w\[\033[00m\]'

        if [ -n "$git_info" ]; then
            PS1+=" \[\033[01;33m\][$git_info]\[\033[00m\]"
        fi

        if [ -n "$python_info" ]; then
            PS1+=" \[\033[01;35m\]($python_info)\[\033[00m\]"
        fi

        PS1+='\n\[\033[01;36m\]╰─»\[\033[00m\] '

    else

        PS1='╭─ '
        PS1+='\u@\h:\w'

        if [ -n "$git_info" ]; then
            PS1+=" [$git_info]"
        fi

        if [ -n "$python_info" ]; then
            PS1+=" ($python_info)"
        fi

        PS1+='\n  ╰─» '
    fi
}

# Preserve any existing PROMPT_COMMAND.
PROMPT_COMMAND="__prompt_update${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

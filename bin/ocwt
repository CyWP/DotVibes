#!/bin/bash
# ocwt — port opencode sessions from git worktrees back to their main repo.
#
#   ocwt [name]
#
# Finds every opencode session whose directory is a linked git worktree,
# groups them per worktree and asks, one worktree at a time, whether to move
# its sessions to the main checkout (via opencode's own API, like `ocmv`).
# y = move, n/Enter = skip, q = quit.
#
# [name] narrows it to worktrees whose directory name or branch equals it
# (a full path works too). Only worktrees that still exist on disk can be
# ported — for a removed one the main repo is unknown; those are counted and
# mentioned, use `ocmv <old> <new>` for them.
# Sessions in subdirectories of a worktree are not touched. A move is
# reversible: `ocmv <main-repo> <worktree>`.

set -u

[ $# -le 1 ] || { echo "usage: ocwt [name]" >&2; exit 2; }
command -v jq >/dev/null       || { echo "ocwt: jq is required" >&2; exit 1; }
command -v opencode >/dev/null || { echo "ocwt: opencode not found" >&2; exit 1; }
filter=${1:-}

# --- 1. every session, as "directory<TAB>id<TAB>title" -----------------------

list_sessions() {
  local archived=$1 cursor="" url resp
  while :; do
    url="/api/session?limit=200&archived=$archived"
    [ -n "$cursor" ] && url+="&cursor=$cursor"
    resp=$(opencode api get "$url" 2>&1) || { echo "ocwt: list failed: $resp" >&2; return 1; }
    jq -r '.data[] | "\(.location.directory)\t\(.id)\t\(.title)"' <<<"$resp" \
      || { echo "ocwt: bad response: $resp" >&2; return 1; }
    cursor=$(jq -r '.cursor.next // empty' <<<"$resp")
    [ -n "$cursor" ] || break
  done
}

all=$({ list_sessions false; list_sessions true; } | sort -u) || exit 1
[ -n "$all" ] || { echo "No opencode sessions found."; exit 0; }

# --- 2. which session directories are live linked worktrees ------------------

worktrees=()          # worktree paths, in order
declare -A main_of=() # worktree -> main repo
gone=0

while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  if [ ! -d "$dir" ]; then
    # only count it if the name filter could still apply
    if [ -z "$filter" ] || [ "$(basename "$dir")" = "$filter" ] || [ "$dir" = "$filter" ]; then
      gone=$((gone + 1))
    fi
    continue
  fi
  gitdir=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || continue
  case "$gitdir" in
    */.git/worktrees/*) ;;
    *) continue ;;                      # main checkout or not a repo
  esac
  # the session dir must be the worktree root itself, not a subdirectory
  [ "$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" = "$dir" ] || continue
  main=${gitdir%/.git/worktrees/*}
  if [ -n "$filter" ]; then
    branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    [ "$(basename "$dir")" = "$filter" ] || [ "$branch" = "$filter" ] \
      || [ "$dir" = "$filter" ] || continue
  fi
  worktrees+=("$dir")
  main_of[$dir]=$main
done < <(cut -f1 <<<"$all" | sort -u)

if [ "${#worktrees[@]}" -eq 0 ]; then
  echo "No sessions found in linked worktrees${filter:+ matching '$filter'}."
  [ "$gone" -gt 0 ] && echo "($gone session director$([ "$gone" -eq 1 ] && echo y || echo ies) no longer exist — use ocmv.)"
  exit 0
fi

# The move is applied asynchronously: poll until the session shows the new
# directory (up to ~10s). $1 = session id, $2 = target directory.
move_session() {
  local id=$1 target=$2 out i
  out=$(opencode api post "/api/session/$id/move" \
          --data "$(jq -nc --arg d "$target" '{directory: $d}')" 2>&1) \
    && ! grep -q '^HTTP [45]' <<<"$out" || { echo "$out"; return 1; }
  for i in $(seq 20); do
    [ "$(opencode api get "/api/session/$id" 2>/dev/null | jq -r '.data.location.directory')" = "$target" ] \
      && return 0
    sleep 0.5
  done
  echo "move accepted but session still not in $target"; return 1
}

# --- 3. one prompt per worktree ----------------------------------------------

moved=0 fail=0 skipped=0
for wt in "${worktrees[@]}"; do
  main=${main_of[$wt]}
  mapfile -t rows < <(awk -F'\t' -v d="$wt" '$1 == d { print $2 "\t" $3 }' <<<"$all")
  branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "(detached)")

  echo
  echo "Worktree $wt  [$branch]"
  echo "  → main repo $main"
  for r in "${rows[@]}"; do printf '    %s  %s\n' "${r%%$'\t'*}" "${r#*$'\t'}"; done
  read -r -p "  Move ${#rows[@]} session(s) to the main repo? [y/N/q] " ans
  case $ans in
    [yY]) ;;
    [qQ]) echo "Quit."; break ;;
    *)    skipped=$((skipped + ${#rows[@]})); continue ;;
  esac

  for r in "${rows[@]}"; do
    id=${r%%$'\t'*}
    if out=$(move_session "$id" "$main"); then
      moved=$((moved + 1))
    else
      fail=$((fail + 1)); echo "    FAILED $id: $out" >&2
    fi
  done
done

echo
echo "Moved $moved, skipped $skipped, failed $fail."
[ "$gone" -gt 0 ] && echo "($gone session director$([ "$gone" -eq 1 ] && echo y || echo ies) no longer exist — use ocmv.)"
[ "$fail" -eq 0 ]

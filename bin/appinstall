#!/usr/bin/env bash
# appinstall — "install" an AppImage so the desktop environment finds it.
#
#   appinstall <path-to-appimage> <name> <path-to-icon-image>
#
# Bundles the AppImage and its icon together with a generated .desktop file in
# a per-app subfolder of ~/.local/share/applications, makes the AppImage
# executable, and refreshes the desktop database. Re-running with the same
# name replaces that bundle in place; delete the subfolder to uninstall.
#
# Example:
#   appinstall ~/Downloads/Bitwarden-2025.1.0-x86_64.AppImage Bitwarden ~/dl/bitwarden.png

set -euo pipefail

# --- argument handling -----------------------------------------------------------
if [[ $# -ne 3 ]]; then
  echo "Usage: $0 <appimage> <app name> <icon image>" >&2
  echo "Example: $0 ~/Downloads/Foo-1.2-x86_64.AppImage Foo ~/Pictures/foo.png" >&2
  exit 1
fi

APPIMAGE_SRC="$1"
APP_NAME="$2"
ICON_SRC="$3"

for f in "$APPIMAGE_SRC" "$ICON_SRC"; do
  if [[ ! -f "$f" ]]; then
    echo "Error: not a file: $f" >&2
    exit 1
  fi
done
if ! grep -q "AppImage Type" "$APPIMAGE_SRC" 2>/dev/null; then
  echo "warn: $APPIMAGE_SRC does not look like an AppImage — installing anyway" >&2
fi

# --- layout ----------------------------------------------------------------------
# Same sanitizer for the desktop ID and the bundle folder so they line up.
ID=$(printf '%s' "$APP_NAME" | sed -E -e 's/[^A-Za-z0-9.]+/-/g' -e 's/^-+//' -e 's/-+$//')
if [[ -z "$ID" ]]; then
  echo "Error: could not derive a .desktop id from name '$APP_NAME'" >&2
  exit 1
fi

APPS_DIR="$HOME/.local/share/applications"
BUNDLE="$APPS_DIR/$ID"
mkdir -p "$BUNDLE"

# --- 1. bundle the AppImage + icon -----------------------------------------------
# Fixed filenames so a re-install replaces the old version instead of
# accumulating stale copies next to it.
APPIMAGE_DST="$BUNDLE/$ID.AppImage"
ICON_EXT="${ICON_SRC##*.}"
ICON_DST="$BUNDLE/icon.$ICON_EXT"

install -m 755 "$APPIMAGE_SRC" "$APPIMAGE_DST"
cp "$ICON_SRC" "$ICON_DST"

# --- 2. write the .desktop file --------------------------------------------------
DESKTOP_FILE="$BUNDLE/$ID.desktop"
cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME (installed via appinstall)
Exec="$APPIMAGE_DST" %U
Icon=$ICON_DST
Terminal=false
Categories=Utility;
EOF
chmod 755 "$DESKTOP_FILE"

# --- 3. refresh the desktop registry ---------------------------------------------
if command -v update-desktop-database > /dev/null; then
  update-desktop-database "$APPS_DIR"
  echo "-> updated the desktop database at $APPS_DIR"
else
  echo "warn: update-desktop-database not found — most desktops pick the new entry up automatically; log out/in otherwise" >&2
fi
if command -v desktop-file-validate > /dev/null; then
  desktop-file-validate "$DESKTOP_FILE" \
    || echo "warn: $DESKTOP_FILE did not fully validate (usually a Categories nit; harmless)" >&2
fi

echo
echo "installed '$APP_NAME':"
echo "  app:     $APPIMAGE_DST"
echo "  icon:    $ICON_DST"
echo "  entry:   $DESKTOP_FILE"
echo "to uninstall, delete the folder: $BUNDLE"

#!/bin/bash
# Usage: ./create_or_attach_tmux_session.zsh session_name
# If run inside tmux, switches to the target session or creates it if needed.

session_name="$1"

# Create session if it doesn't exist
if ! tmux has-session -t "$session_name" 2>/dev/null; then
  tmux new-session -d -s "$session_name"
  echo "Session '$session_name' has been created."
else
  echo "Session '$session_name' already exists."
fi

# If inside tmux, switch client to the session; else, attach
if [[ -n "$TMUX" ]]; then
  tmux switch-client -t "$session_name"
else
  tmux attach -t "$session_name"
